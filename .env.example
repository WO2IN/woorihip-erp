# 신규: quality/*, engineering/*, office/*
MINIO_DOCS_BUCKET=woorihip-docs
# 신규: uploads/*, equipment/* 사진
MINIO_MEDIA_BUCKET=woorihip-media
# DB 백업 등 (앱에서 아직 미사용)
