MINIO_ENDPOINT=192.168.0.210
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# (선택) 예전 단일 버킷. 신규 운영은 docs/media만 사용. 비우거나 미사용 가능.
